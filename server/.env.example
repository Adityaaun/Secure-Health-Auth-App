# Server
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# CAPTCHA
# Use demo only for local testing. Use recaptcha for deployment.
CAPTCHA_MODE=demo
RECAPTCHA_SECRET=

# Email / SMTP (optional locally; recommended for production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HealthGuard Security" <security@example.com>
